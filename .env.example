# Copie para .env e ajuste. Veja docs/auto-hospedagem.md.

# "development" ou "production". Em produção, o servidor recusa configurações inseguras.
BATEPAPO_ENV=production

# Segredo para o HMAC dos telefones (64 caracteres hex). Gere com: openssl rand -hex 32
# Guarde em local seguro: se for perdido, ninguém consegue mais entrar na conta pelo número.
BATEPAPO_PHONE_PEPPER=

# Chave secreta do PIN, fora do banco (protege os PINs se o banco vazar).
# "local": defina BATEPAPO_PIN_PEPPER (64 caracteres hex, diferente do pepper do telefone).
# "openbao": o HMAC é feito no OpenBao/Vault Transit e a chave nunca sai de lá (recomendado).
# Veja docs/seguranca-da-conta.md, seção 3.9.
BATEPAPO_PIN_KEY_PROVIDER=local
BATEPAPO_PIN_PEPPER=
# BATEPAPO_OPENBAO_ADDR=https://bao.interno.exemplo.br:8200
# BATEPAPO_OPENBAO_TOKEN_FILE=/run/secrets/openbao-token

POSTGRES_PASSWORD=troque-esta-senha

# Envio de SMS: "webhook" chama um serviço HTTP seu, que fala com o provedor de SMS.
BATEPAPO_SMS_PROVIDER=webhook
BATEPAPO_SMS_WEBHOOK_URL=
BATEPAPO_SMS_WEBHOOK_KEY=

# Ative apenas atrás de um proxy reverso confiável (Caddy, Nginx...).
BATEPAPO_TRUST_PROXY_HEADERS=true

# Dias que mensagens não entregues e anexos ficam no servidor.
BATEPAPO_RETENTION_DAYS=30

# Sessões sem uso expiram depois deste prazo.
BATEPAPO_SESSION_IDLE_DAYS=90

# Notificações push sem conteúdo (opcional). Sem elas, as mensagens aparecem
# quando a pessoa abre o app.
# BATEPAPO_PUSH_FCM_CREDENTIALS_FILE=/run/secrets/firebase-conta-de-servico.json
# BATEPAPO_PUSH_APNS_KEY_FILE=/run/secrets/AuthKey_XXXXXXXXXX.p8
# BATEPAPO_PUSH_APNS_KEY_ID=XXXXXXXXXX
# BATEPAPO_PUSH_APNS_TEAM_ID=YYYYYYYYYY
# BATEPAPO_PUSH_APNS_TOPIC=br.org.batepapo.app
# BATEPAPO_PUSH_UNIFIEDPUSH=true

# Conta protegida por PIN: o PIN deixa de ser exigido se o aparelho registrado
# ficar este tempo sem uso (recuperação para quem perdeu PIN e código).
BATEPAPO_LOCK_INACTIVITY_DAYS=7
